{
    "name": "Web-UI-Saucedemo.com",
    "version": "1.0.0",
    "description": "Tugas sesi 9 Web UI automation",
    "type": "module",
    "scripts": {
        "test": "mocha test --recursive --timeout 60000 --report spec",
        "test-report-html": "mocha test --recursive --timeout 60000 --reporter mocha-simple-html-reporter --reporter-options output=report.html",
        "test-report": "mocha test --recursive --timeout 60000 --reporter mochawesome"
    },
    "dependencies": {
        "ajv": "^8.20.0",
        "node-fetch": "^3.3.2",
        "pixelmatch": "^7.2.0",
        "pngjs": "^7.0.0",
        "selenium-webdriver": "^4.17.0"
    },
    "devDependencies": {
        "chai": "^6.2.2",
        "mocha": "^11.3.0",
        "mocha-simple-html-reporter": "2.0.0",
        "mochawesome": "^7.1.4"
    }
}
